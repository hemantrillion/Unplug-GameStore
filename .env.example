# Local mode starts without this file. Production requires explicit settings.
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://127.0.0.1:3000
DATA_DIR=.local-data
NODE_ENV=development
# Optional initial admin override. Otherwise a random password is generated locally.
ADMIN_EMAIL=admin@unplug.local
ADMIN_PASSWORD=
# Set all three to deliver verification and recovery emails through SMTP.
SMTP_URL=
MAIL_FROM=
# Production registration is invite-only unless deliberately enabled.
ALLOW_REGISTRATION=true
